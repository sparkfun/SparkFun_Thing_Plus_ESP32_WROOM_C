	(text "Use boot control pins with caution: 0, 2, 5, 12, 15.\nIO0: avoid device connections. Controls Qwiic power.\nIO2: avoid external pull-ups; the bootloader fails.\nIO5: has a built-in pull-up at POR.\nIO12: avoid external pull-ups; the bootloader fails.\nIO15: has a built-in pull-up at POR.\n\nADC2 is unavailable when WiFi is enabled.\n\nIO16: used by the module's PSRAM (ESP32-WROOM-32E-N16R2).\nLeave it unconnected.\nIO1: UART0 TX, drives the USB-serial converter\nand the header TX pin (through R1)."
		(exclude_from_sim no)
		(at 187.96 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d8e19115-e1fc-5133-9615-ec2fcaa47381")
	)
